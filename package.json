{
  "name": "astrovanta-monorepo",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:desktop": "npm run dev -w apps/desktop",
    "dev:mobile": "npm run start -w apps/mobile",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop"
  }
}
